# Site URL (used for sitemap, schema, canonicals when not overridden in code)
NEXT_PUBLIC_SITE_URL=https://www.investlink.ai

# Google Analytics 4
# Get your Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable GA in development (optional)
# NEXT_PUBLIC_GA_FORCE_ENABLE=true

# Newsletter — Kit hosted form (double opt-in). The form ID is public and embedded at build time.
# The browser posts to https://app.kit.com/forms/<id>/subscriptions; no API key is used by the site.
# Production builds post to Kit whenever KIT_FORM_ID (or NEXT_PUBLIC_KIT_FORM_ID) is a valid ID,
# and hide every signup block when it isn't. Dev/test builds use an offline mock that sends
# nothing unless NEXT_PUBLIC_EMAIL_PROVIDER=kit is also set. The form ID is fixed at build
# time: changing KIT_FORM_ID needs a redeploy.
# KIT_FORM_ID=9042473
# NEXT_PUBLIC_EMAIL_PROVIDER=kit
# NEXT_PUBLIC_KIT_ATTRIBUTION=hidden-tags
# With Kit, hidden-tags requires tag IDs; form-per-source requires distinct sourceForms IDs
# in lib/attribution/tag-list.mjs (see docs/I3-PREVIEW.md).
# Local evidence builds only: allow the offline mock on a production build (ignored when
# VERCEL_ENV=production).
# NEXT_PUBLIC_SIGNUP_TEST_MODE=1

# Umami Cloud (public website ID; script only loads when set)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Operator only, never read by the site or its build: read-only tag report (scripts/kit-tag-report.mjs)
# KIT_API_KEY=
