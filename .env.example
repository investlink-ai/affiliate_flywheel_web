# Site URL (used for sitemap, schema, canonicals when not overridden in code)
NEXT_PUBLIC_SITE_URL=https://www.investlink.ai

# Google Analytics 4
# Get your Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable GA in development (optional)
# NEXT_PUBLIC_GA_FORCE_ENABLE=true

# Newsletter — Kit hosted form (double opt-in). Public values, embedded at build time.
# The browser posts to https://app.kit.com/forms/<id>/subscriptions; no API key is used by the site.
# Without both values the signup forms are an offline mock that sends nothing.
# NEXT_PUBLIC_EMAIL_PROVIDER=kit
# NEXT_PUBLIC_KIT_FORM_ID=123456
# With kit, every tag in lib/attribution/tag-list.mjs needs its Kit tag ID or the build fails
# (signups must carry their src-*/cmp-* tags; see docs/I3-PREVIEW.md).

# Umami Cloud (public website ID; script only loads when set)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Operator only, never in the site's hosting env: read-only tag report (scripts/kit-tag-report.mjs)
# KIT_API_KEY=
# KIT_FORM_ID=
