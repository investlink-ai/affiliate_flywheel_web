# Site URL (used for sitemap, schema, canonicals when not overridden in code)
NEXT_PUBLIC_SITE_URL=https://www.investlink.ai

# Google Analytics 4
# Get your Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable GA in development (optional)
# NEXT_PUBLIC_GA_FORCE_ENABLE=true

# Newsletter — Kit hosted form (double opt-in). The form ID is public and embedded at build time.
# The browser posts to https://app.kit.com/forms/<id>/subscriptions; no API key is used by the site.
# Production builds post to Kit whenever KIT_FORM_ID (or NEXT_PUBLIC_KIT_FORM_ID) is a valid ID,
# and hide every signup block when it isn't. Dev/test builds use an offline mock that sends
# nothing unless NEXT_PUBLIC_EMAIL_PROVIDER=kit is also set.
# KIT_FORM_ID=123456
# NEXT_PUBLIC_EMAIL_PROVIDER=kit
# Local evidence builds only: allow the offline mock on a production build.
# NEXT_PUBLIC_SIGNUP_TEST_MODE=1
