# Site URL (used for sitemap, schema, canonicals when not overridden in code)
NEXT_PUBLIC_SITE_URL=https://investlink.com

# Google Analytics 4
# Get your Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable GA in development (optional)
# NEXT_PUBLIC_GA_FORCE_ENABLE=true

# Newsletter — Kit API v4 for email collection (PRD 3.2.1)
# KIT_API_KEY: Kit > Account Settings > Developer > Add new key (V4 API key)
# KIT_FORM_ID: From form URL (e.g. app.kit.com/forms/123456/edit → 123456)
# Without these, signups are logged only.
# KIT_API_KEY=your-api-key
# KIT_FORM_ID=your-form-id
