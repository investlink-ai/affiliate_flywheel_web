# Site URL (used for sitemap, schema, canonicals when not overridden in code)
NEXT_PUBLIC_SITE_URL=https://affievo.com

# Google Analytics 4
# Get your Measurement ID from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable GA in development (optional)
# NEXT_PUBLIC_GA_FORCE_ENABLE=true

# Newsletter Form Actions (optional)
# Mailchimp: Get from Mailchimp > Audience > Signup forms > Embedded forms
# NEXT_PUBLIC_MAILCHIMP_ACTION=https://your-list.us1.list-manage.com/subscribe/post?u=xxx&id=xxx

# ConvertKit: Get from ConvertKit > Landing Pages & Forms > Form settings
# NEXT_PUBLIC_CONVERTKIT_FORM_ID=your-form-id
